# ═══════════════════════════════════════════════════════════════════════════
# AlsoNotify frontend environment
#
# Copy to .env.local for local development.
#
# Every variable here is inlined into the client bundle at build time, so a
# change only takes effect after the dev server restarts. Never put a secret
# in a NEXT_PUBLIC_ variable: it ships to the browser.
# ═══════════════════════════════════════════════════════════════════════════

# Base URL of the backend API. Also used to build the connect-src entry in the
# Content Security Policy (next.config.mjs), so a wrong value here shows up as
# blocked requests in the browser console rather than a clear error.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare Turnstile site key, rendered on the login and register pages.
# Leave it empty and the widget throws "Invalid input for parameter sitekey"
# and never issues a token, so both forms are rejected by the backend.
# Cloudflare's public always-pass test key for local development:
#   1x00000000000000000000AA
# The matching secret key lives in the BACKEND environment as
# TURNSTILE_SECRET_KEY; this app never verifies tokens itself.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry DSN, shared by the browser, server and edge runtimes. Optional:
# leaving it empty disables error reporting and the app runs normally.
# The Sentry org and project are hardcoded in next.config.mjs, so no auth
# token is needed for a normal build.
NEXT_PUBLIC_SENTRY_DSN=
